# Setting that turns off live-reload while editing in AI Studio (not a secret)
DISABLE_HMR=true

# TMDB API Key (v3 key from themoviedb.org -> Settings -> API)
# Kept server-side only in server.ts proxy routes and GitHub Actions secrets
TMDB_API_KEY=

# Supabase Project URL (e.g., https://xxxx.supabase.co)
# Found under Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=

# Supabase Service Role Key (used ONLY server-side / in GitHub Actions importer scripts)
# WARNING: Bypasses RLS. Never put in client bundles or public repositories.
SUPABASE_SERVICE_KEY=

# Supabase Publishable / Anon Key (safe for client-side queries with Row Level Security turned on)
# Found under Supabase Dashboard -> Project Settings -> API
SUPABASE_ANON_KEY=